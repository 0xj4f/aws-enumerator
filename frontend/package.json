{
  "name": "aws-enumerator-dashboard",
  "private": true,
  "version": "0.0.0",
  "description": "Source of the aws-enumerator attack-graph dashboard; `npm run build` writes aws_enumerator/dashboard/.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@vue-flow/background": "1.3.2",
    "@vue-flow/core": "1.48.2",
    "vue": "3.5.45",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "3.2.7",
    "vue-tsc": "3.3.14"
  }
}
