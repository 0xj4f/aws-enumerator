{
  "RoleName": "demo-irsa-reader",
  "InlinePolicies": {
    "read": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "s3:GetObject",
            "s3:ListBucket"
          ],
          "Resource": [
            "arn:aws:s3:::demo-eks-data",
            "arn:aws:s3:::demo-eks-data/*"
          ]
        }
      ]
    }
  }
}
