{
  "UserName": "demo-deployer",
  "InlinePolicies": {
    "deploy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "iam:PassRole"
          ],
          "Resource": "*"
        },
        {
          "Effect": "Allow",
          "Action": [
            "lambda:UpdateFunctionCode",
            "lambda:GetFunction"
          ],
          "Resource": "*"
        },
        {
          "Effect": "Allow",
          "Action": [
            "ecs:RunTask",
            "ecs:RegisterTaskDefinition"
          ],
          "Resource": "*"
        },
        {
          "Effect": "Allow",
          "Action": [
            "cloudformation:CreateStack",
            "cloudformation:UpdateStack"
          ],
          "Resource": "*"
        },
        {
          "Effect": "Allow",
          "Action": [
            "codebuild:StartBuild"
          ],
          "Resource": "arn:aws:codebuild:eu-west-2:123456789012:project/demo-build"
        },
        {
          "Effect": "Allow",
          "Action": [
            "glue:CreateJob",
            "glue:StartJobRun"
          ],
          "Resource": "*"
        },
        {
          "Effect": "Allow",
          "Action": [
            "sagemaker:CreatePresignedNotebookInstanceUrl"
          ],
          "Resource": "*"
        },
        {
          "Effect": "Allow",
          "Action": [
            "kms:PutKeyPolicy",
            "kms:CreateGrant"
          ],
          "Resource": "arn:aws:kms:eu-west-2:123456789012:key/4b2c1a3d-aaaa-4bbb-8ccc-1d2e3f4a5b6c"
        },
        {
          "Effect": "Allow",
          "Action": [
            "sqs:*"
          ],
          "Resource": "arn:aws:sqs:eu-west-2:123456789012:demo-*"
        },
        {
          "Effect": "Allow",
          "Action": [
            "dynamodb:Scan"
          ],
          "Resource": "*"
        }
      ]
    }
  }
}
