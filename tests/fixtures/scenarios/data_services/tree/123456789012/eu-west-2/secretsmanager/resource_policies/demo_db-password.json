{
  "SecretArn": "arn:aws:secretsmanager:eu-west-2:123456789012:secret:demo/db-password-babobj",
  "SecretName": "demo/db-password",
  "ResourcePolicy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "AWS": "arn:aws:iam::999999999999:root"
        },
        "Action": "secretsmanager:GetSecretValue",
        "Resource": "*"
      },
      {
        "Effect": "Allow",
        "Principal": {
          "AWS": "arn:aws:iam::123456789012:role/demo-app-role"
        },
        "Action": "secretsmanager:GetSecretValue",
        "Resource": "*"
      }
    ]
  }
}
