{
  "FunctionArn": "arn:aws:lambda:eu-west-2:123456789012:function:demo-public-fn",
  "FunctionName": "demo-public-fn",
  "ResourcePolicy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": "*",
        "Action": "lambda:InvokeFunctionUrl",
        "Resource": "arn:aws:lambda:eu-west-2:123456789012:function:demo-public-fn",
        "Condition": {
          "StringEquals": {
            "lambda:FunctionUrlAuthType": "NONE"
          }
        }
      },
      {
        "Effect": "Allow",
        "Principal": {
          "AWS": "*"
        },
        "Action": "lambda:InvokeFunction",
        "Resource": "arn:aws:lambda:eu-west-2:123456789012:function:demo-public-fn"
      }
    ]
  }
}
