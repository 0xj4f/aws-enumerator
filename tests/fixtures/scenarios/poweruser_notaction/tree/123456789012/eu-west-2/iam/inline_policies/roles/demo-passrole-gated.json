{
  "RoleName": "demo-passrole-gated",
  "InlinePolicies": {
    "p": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "iam:PassRole",
          "Resource": "*",
          "Condition": {
            "StringEquals": {
              "iam:PassedToService": "ec2.amazonaws.com"
            }
          }
        },
        {
          "Effect": "Allow",
          "Action": [
            "lambda:CreateFunction",
            "lambda:InvokeFunction"
          ],
          "Resource": "*"
        }
      ]
    }
  }
}
