{
  "LambdaFunctionConfigurations": [
    {
      "Events": [
        "s3:ObjectCreated:*"
      ],
      "Id": "demo-on-upload",
      "LambdaFunctionArn": "arn:aws:lambda:eu-west-2:111122223333:function:demo-processor"
    }
  ],
  "QueueConfigurations": [
    {
      "Events": [
        "s3:ObjectRemoved:*"
      ],
      "Id": "demo-to-queue",
      "QueueArn": "arn:aws:sqs:eu-west-2:111122223333:demo-queue"
    }
  ]
}
